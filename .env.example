# Copy this file to .env and fill in real values
# NEVER commit .env to git

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=recommendly
POSTGRES_USER=recommendly_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_ISSUER=recommendly
JWT_AUDIENCE=recommendly-users
JWT_EXPIRATION_MS=86400000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
